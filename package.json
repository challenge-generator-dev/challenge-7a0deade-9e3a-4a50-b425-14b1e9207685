{
  "name": "product-crud-api",
  "version": "1.0.0",
  "description": "API for product management using DynamoDB and Express",
  "main": "src/main.ts",
  "scripts": {
    "start": "ts-node src/main.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "express",
    "dynamodb",
    "typescript",
    "crud"
  ],
  "author": "Pragma",
  "license": "MIT",
  "dependencies": {
    "express": "4.21.0",
    "dotenv": "^16.4.5",
    "@aws-sdk/client-dynamodb": "3.632.0",
    "@aws-sdk/lib-dynamodb": "3.632.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.7.0",
    "aws-sdk-client-mock": "4.0.1",
    "jest": "29.7.0",
    "@types/jest": "29.5.12",
    "ts-jest": "29.2.4",
    "typescript": "5.7.0",
    "ts-node": "^10.9.2",
    "@types/dotenv": "^8.2.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json",
      "node"
    ],
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\.ts$": "ts-jest"
    }
  }
}